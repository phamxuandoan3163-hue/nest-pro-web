# Paddle.js values for the Sandbox pricing preview.
# Keep this Sandbox-only client token in local development and Preview deployments.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_SANDBOX_CLIENT_TOKEN=test_replace_with_your_sandbox_client_token

# Paddle API keys, webhook signing secrets, database credentials, and email credentials
# belong only in the license-api service environment, never in website/client code.
