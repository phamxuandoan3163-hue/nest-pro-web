# Paddle environment selector. Keep this set to sandbox until the full test checklist passes.
PADDLE_ENVIRONMENT=sandbox
# Secret from the Paddle Sandbox notification destination for /api/rest/paddle/webhook
PADDLE_NOTIFICATION_SECRET=
# PostgreSQL connection string from the license API database
DATABASE_URL=
# 32 random bytes encoded as 64 hexadecimal characters; keep stable for key recovery.
LICENSE_ENCRYPTION_KEY=
# Resend API key and a sender address whose domain is verified in Resend.
RESEND_API_KEY=
LICENSE_EMAIL_FROM=
# Explicit allowed origins. CEP panels use an opaque "null" origin; include it only for the CEP license API.
LICENSE_ALLOWED_ORIGINS=https://ainovanesting.pro,https://www.ainovanesting.pro,null

# Website project only; a client-side Paddle token is public, but this must be a Sandbox token.
NEXT_PUBLIC_PADDLE_SANDBOX_CLIENT_TOKEN=
